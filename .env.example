# LocalDepth Platform - Environment Variables Template
NODE_ENV=development

# -------------------------------------------------------------
# Service Ports & URLs (Internal & External)
# -------------------------------------------------------------
API_GATEWAY_PORT=4000
API_GATEWAY_URL=http://localhost:4000

AUTH_SERVICE_PORT=4001
AUTH_SERVICE_URL=http://localhost:4001

CONTENT_SERVICE_PORT=4002
CONTENT_SERVICE_URL=http://localhost:4002

MEDIA_SERVICE_PORT=4003
MEDIA_SERVICE_URL=http://localhost:4003

SEARCH_SERVICE_PORT=4004
SEARCH_SERVICE_URL=http://localhost:4004

RECOMMENDATIONS_SERVICE_PORT=4005
RECOMMENDATIONS_SERVICE_URL=http://localhost:4005

EMAIL_SERVICE_PORT=4006
EMAIL_SERVICE_URL=http://localhost:4006

ANALYTICS_SERVICE_PORT=4007
ANALYTICS_SERVICE_URL=http://localhost:4007

# Frontend & Admin URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# -------------------------------------------------------------
# Security & JWT
# -------------------------------------------------------------
JWT_SECRET=localdepth_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------
# PostgreSQL Database
# -------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=localdepth
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/localdepth?schema=public

# -------------------------------------------------------------
# Redis (Cache & BullMQ)
# -------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------------------------------------------------
# MinIO (S3 Compatible Storage)
# -------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=localdepth-media
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000/localdepth-media

# -------------------------------------------------------------
# Meilisearch
# -------------------------------------------------------------
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=localdepth_meili_master_key_change_in_production

# -------------------------------------------------------------
# Email (Resend / Postmark)
# -------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="LocalDepth <hello@localdepth.com>"
